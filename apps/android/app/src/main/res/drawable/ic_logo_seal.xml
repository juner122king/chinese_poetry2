<?xml version="1.0" encoding="utf-8"?>
<!--
  主站竖章 LogoMark（components/LogoMark.tsx / app/icon.svg 同构）
  viewBox 逻辑 32×38 → 居中铺在 108 adaptive 安全区（略收，避免桌面偏大）。
  外框宣纸描边 + 内框朱砂圆角细描边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      scale = 1.15；offset (35.6, 32.15)
      outer LogoMark (3,3,26,32) → (39.05, 35.6, 29.9, 36.8)
      inner LogoMark (9,9.5,14,19) rx=1.2 → (45.95, 43.075, 16.1, 21.85) rx=1.38
      stroke 2.25*1.15≈2.59 / 0.85*1.15≈0.98
    -->
    <!-- Outer — hard seal edge -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M39.05,35.6 h29.9 v36.8 h-29.9 z"
        android:strokeWidth="2.59"
        android:strokeColor="@color/paper"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <!-- Inner — cinnabar, slight round -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M47.33,43.075 L60.67,43.075 A1.38,1.38 0 0 1 62.05,44.455 L62.05,63.545 A1.38,1.38 0 0 1 60.67,64.925 L47.33,64.925 A1.38,1.38 0 0 1 45.95,63.545 L45.95,44.455 A1.38,1.38 0 0 1 47.33,43.075 Z"
        android:strokeWidth="0.98"
        android:strokeColor="@color/cinnabar"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
