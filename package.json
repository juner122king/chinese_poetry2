{
  "name": "chinese_poetry2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:build": "npx tsx scripts/build-data.ts",
    "data:build:local": "npx tsx scripts/build-data.ts --skip-fetch",
    "enrich:motifs": "npx tsx scripts/enrich-poems.ts",
    "enrich:motifs:llm": "npx tsx scripts/enrich-poems.ts --llm --concurrency 1 --delay-ms 1500",
    "enrich:motifs:llm:resume": "npx tsx scripts/enrich-poems.ts --llm --only-missing-llm --concurrency 1 --delay-ms 1500 --keep-on-fail",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.42.2",
    "next": "16.2.11",
    "opencc-js": "^1.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pinyin-pro": "^3.28.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
